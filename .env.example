# ========================================================
# DeepFieldPro Environment Configuration Template
# ========================================================
# Rename this file to .env and populate with real values
# DO NOT commit the .env file to version control.

# --------------------------------------------------------
# 1. External APIs & Brokers
# --------------------------------------------------------
# Stair AI Execution Broker Key
STAIR_AI_API_KEY=your_stair_ai_api_key_here

# --------------------------------------------------------
# 2. Risk Management & Capital Allocation
# --------------------------------------------------------
# Starting Bankroll in base currency (e.g. 300.0)
DEEPFIELD_STARTING_BANKROLL=300.0

# Max percentage of daily starting bankroll that can be at risk simultaneously (1.0 = 100%)
DEEPFIELD_MAX_DAILY_EXPOSURE_PCT=1.0

# Max allowed drawdown from peak before global halt (1.0 = 100%)
DEEPFIELD_MAX_DRAWDOWN_PCT=1.0

# Max loss in a single day before daily halt (1.0 = 100%)
DEEPFIELD_DAILY_STOP_LOSS_PCT=1.0

# Kelly Criterion multiplier (0.25 = Quarter Kelly)
DEEPFIELD_BASE_KELLY_FRACTION=0.25

# --------------------------------------------------------
# 3. Model Inference Thresholds
# --------------------------------------------------------
# Minimum Expected Value (EV) required to recommend a bet (0.05 = 5% edge)
DEEPFIELD_MIN_EV_THRESHOLD=0.05

# Minimum confidence (probability) required to recommend a bet
DEEPFIELD_MIN_CONFIDENCE_PCT=55.0

# --------------------------------------------------------
# 4. Server Configuration
# --------------------------------------------------------
# Flask Server Port (Default: 5050)
FLASK_PORT=5050
FLASK_HOST=0.0.0.0
FLASK_ENV=production

# --------------------------------------------------------
# 5. Line Shopping — The Odds API
# --------------------------------------------------------
# Free tier: 500 requests/month — https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key_here

# --------------------------------------------------------
# 6. AI Workers
# --------------------------------------------------------
# NVIDIA NIM — Qwen3.5-122B (tools/openrouter_worker.py)
NVIDIA_API_KEY=your_nvidia_api_key_here

# OpenRouter fallback — Qwen3-80B (tools/openrouter_worker.py)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Microsoft Copilot worker (tools/copilot_worker.py) — sydney-py unofficial API
# 1. Go to https://copilot.microsoft.com and sign in
# 2. F12 → Application → Cookies → copilot.microsoft.com → copy _U value
BING_U_COOKIE=your_bing_u_cookie_here
