*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/

# Logs
*.log
daemon_out.log

# System / IDE
.vscode/
.idea/
.DS_Store
Thumbs.db

# Project Specific (Keeping models and core data as requested)
# We exclude temporary artifacts but keep the primary state
*.bak
artifacts/
temp/
*.tmp

# Large data files — too big for GitHub (use LFS or exclude)
data/betarabia_api_responses.json
data/deepfield_browser_data/completed_fixtures.db
data/betarabia_page_probe.html
data/bet_log.db
data/research_bet_log.db

# Browser automation profiles — contain live session cookies, never commit
data/copilot_browser_profile/
data/qwen_browser_profile/

# Third-party/vendored repos and tool caches accidentally left in the tree
UsersEliebotasaurus/
.playwright-mcp/
.qoder/
.understand-anything/

